---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';
import "../styles/blog.css";
import { getCollection } from 'astro:content';

let posts = await getCollection('blog');

const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);

const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 3);

const pageTitle =
  'Ai Mr Ferdy - AI Tools, SEO Systems & Digital Platform';

const pageDescription =
  'Ai Mr Ferdy membangun aplikasi AI, SEO systems, automation tools dan platform digital modern untuk bisnis, creator dan internet ecosystem.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
>

<section class="attendance-hero"><div class="attendance-hero__grid"><div class="attendance-hero__content"><p class="attendance-hero__eyebrow"><span></span> SISTEM AI MR FERDY DIGITAL </p><h1> Sistem Ai Mr Ferdy <strong>Real-Time</strong> untuk Gamer yang Lebih Efisien </h1><p class="attendance-hero__description"> Kelola game, pantau permainan, dan akses laporan presensi secara cepat melalui sistem digital modern yang mudah digunakan. </p><div class="attendance-hero__actions"><a href="/presensi" class="attendance-btn attendance-btn--primary" ><span>✓</span> MULAI AI MR FERDY </a><a href="#fitur" class="attendance-btn attendance-btn--secondary" > LIHAT FITUR <span>→</span></a></div><div class="attendance-stats"><div class="attendance-stat"><strong> REAL-TIME </strong><span> DATA permainan </span></div><div class="attendance-stat"><strong> 24/7 </strong><span> AKSES SISTEM </span></div><div class="attendance-stat"><strong> DIGITAL </strong><span> LAPORAN OTOMATIS </span></div></div></div><div class="attendance-clock-area"><div class="attendance-clock-shell"><div class="attendance-clock"><div class="attendance-clock__ticks"></div><span class="attendance-clock__number number-12"> 12 </span><span class="attendance-clock__number number-3"> 03 </span><span class="attendance-clock__number number-6"> 06 </span><span class="attendance-clock__number number-9"> 09 </span><div class="attendance-hand attendance-hand--hour" id="hourHand" ></div><div class="attendance-hand attendance-hand--minute" id="minuteHand" ></div><div class="attendance-hand attendance-hand--second" id="secondHand" ></div><div class="attendance-clock__center"></div></div><div class="attendance-digital"><div class="attendance-digital__time" id="digitalTime" > 00:00:00 </div><div class="attendance-digital__date" id="digitalDate" > MEMUAT TANGGAL </div></div></div></div></div></section>

<style>
