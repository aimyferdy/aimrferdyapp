---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';
import "../styles/blog.css";
import { getCollection } from 'astro:content';

let posts = await getCollection('blog');

const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);

const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 3);

const pageTitle =
  'Ai Mr Ferdy - AI Tools, SEO Systems & Digital Platform';

const pageDescription =
  'Ai Mr Ferdy membangun aplikasi AI, SEO systems, automation tools dan platform digital modern untuk bisnis, creator dan internet ecosystem.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
>

<section class="attendance-hero">
<div class="attendance-hero__grid"><div class="attendance-hero__content"><p class="attendance-hero__eyebrow"><span></span> SISTEM AI MR FERDY DIGITAL </p><h1> Sistem Ai Mr Ferdy <strong>Real-Time</strong> untuk Gamer yang Lebih Efisien </h1><p class="attendance-hero__description"> Kelola game, pantau permainan, dan akses laporan presensi secara cepat melalui sistem digital modern yang mudah digunakan. </p><div class="attendance-hero__actions"><a href="/presensi" class="attendance-btn attendance-btn--primary" ><span>✓</span> MULAI AI MR FERDY </a><a href="#fitur" class="attendance-btn attendance-btn--secondary" > LIHAT FITUR <span>→</span></a></div><div class="attendance-stats"><div class="attendance-stat"><strong> REAL-TIME </strong><span> DATA permainan </span></div><div class="attendance-stat"><strong> 24/7 </strong><span> AKSES SISTEM </span></div><div class="attendance-stat"><strong> DIGITAL </strong><span> LAPORAN OTOMATIS </span></div></div></div><div class="attendance-clock-area"><div class="attendance-clock-shell"><div class="attendance-clock"><div class="attendance-clock__ticks"></div><span class="attendance-clock__number number-12"> 12 </span><span class="attendance-clock__number number-3"> 03 </span><span class="attendance-clock__number number-6"> 06 </span><span class="attendance-clock__number number-9"> 09 </span><div class="attendance-hand attendance-hand--hour" id="hourHand" ></div><div class="attendance-hand attendance-hand--minute" id="minuteHand" ></div><div class="attendance-hand attendance-hand--second" id="secondHand" ></div><div class="attendance-clock__center"></div></div><div class="attendance-digital"><div class="attendance-digital__time" id="digitalTime" > 00:00:00 </div><div class="attendance-digital__date" id="digitalDate" > MEMUAT TANGGAL </div></div></div></div></div>
</section>

<style>
.attendance-hero{position:relative;width:100%;min-height:680px;display:flex;align-items:center;overflow:hidden;padding:50px 20px;color:var(--text);background:radial-gradient(circle at 82% 45%,color-mix(in srgb,var(--primary) 10%,transparent),transparent 35%),var(--bg);transition:background var(--transition),color var(--transition)}.attendance-hero::before{content:"";position:absolute;width:650px;height:650px;right:-260px;top:50%;transform:translateY(-50%);border:1px solid color-mix(in srgb,var(--primary) 18%,transparent);border-radius:50%;pointer-events:none}.attendance-hero::after{content:"";position:absolute;width:470px;height:470px;right:-165px;top:50%;transform:translateY(-50%);border:1px solid color-mix(in srgb,var(--primary) 12%,transparent);border-radius:50%;pointer-events:none}.attendance-hero__grid{position:relative;z-index:2;width:min(1180px,100%);margin:auto;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr);align-items:center;gap:60px}.attendance-hero__content{max-width:680px}.attendance-hero__eyebrow{display:inline-flex;align-items:center;gap:9px;margin-bottom:18px;color:var(--primary);font-size:11px;font-weight:800;letter-spacing:2px}.attendance-hero__eyebrow span{width:7px;height:7px;border-radius:50%;background:var(--primary);box-shadow:0 0 10px color-mix(in srgb,var(--primary) 55%,transparent)}.attendance-hero h1{max-width:720px;margin:0;color:var(--text);font-size:clamp(38px,5vw,64px);font-weight:800;line-height:1.1;letter-spacing:-2px}.attendance-hero h1 strong{color:var(--primary)}.attendance-hero__description{max-width:610px;margin-top:23px;color:var(--text-secondary);font-size:16px;line-height:1.8}.attendance-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.attendance-btn{min-height:50px;padding:0 20px;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid #fff0;border-radius:calc(var(--radius) - 3px);font-size:12px;font-weight:800;letter-spacing:.7px;transition:transform var(--transition),background var(--transition),border-color var(--transition),box-shadow var(--transition)}.attendance-btn--primary{color:#fff;background:var(--primary);box-shadow:0 7px 20px color-mix(in srgb,var(--primary) 25%,transparent)}html[data-theme="dark"] .attendance-btn--primary{color:#202124}.attendance-btn--primary:hover{transform:translateY(-3px);box-shadow:0 10px 26px color-mix(in srgb,var(--primary) 38%,transparent)}.attendance-btn--secondary{color:var(--text);border-color:var(--border);background:var(--surface)}.attendance-btn--secondary:hover{transform:translateY(-3px);border-color:var(--primary);background:var(--surface-hover)}.attendance-stats{display:flex;flex-wrap:wrap;gap:25px;margin-top:40px}.attendance-stat{padding-left:13px;border-left:3px solid var(--primary)}.attendance-stat strong{display:block;color:var(--text);font-size:17px;line-height:1.3}.attendance-stat span{display:block;margin-top:3px;color:var(--text-secondary);font-size:9px;font-weight:700;letter-spacing:1px}.attendance-clock-area{display:flex;align-items:center;justify-content:center}.attendance-clock-shell{position:relative;width:410px;height:410px;display:grid;place-items:center;border:1px solid color-mix(in srgb,var(--primary) 30%,var(--border));border-radius:50%;background:color-mix(in srgb,var(--surface) 65%,transparent);box-shadow:var(--shadow)}.attendance-clock-shell::before{content:"";position:absolute;width:338px;height:338px;border:1px solid color-mix(in srgb,var(--primary) 18%,transparent);border-radius:50%}.attendance-clock-shell::after{content:"";position:absolute;width:370px;height:370px;border-top:2px solid var(--primary);border-right:2px solid #fff0;border-radius:50%;transform:rotate(-42deg);opacity:.55}.attendance-clock{position:relative;z-index:2;width:275px;height:275px;border:1px solid var(--border);border-radius:50%;background:var(--surface);box-shadow:inset 0 0 28px color-mix(in srgb,var(--primary) 7%,transparent)}.attendance-clock__ticks{position:absolute;inset:7px;border-radius:50%;background:repeating-conic-gradient(from 0deg,var(--primary) 0deg 1deg,transparent 1deg 6deg);opacity:.28;-webkit-mask:radial-gradient(transparent 0 89%,#000 90%);mask:radial-gradient(transparent 0 89%,#000 90%)}.attendance-clock__number{position:absolute;z-index:4;color:var(--text-secondary);font-size:10px;font-weight:800}.number-12{top:27px;left:50%;transform:translateX(-50%)}.number-3{top:50%;right:25px;transform:translateY(-50%)}.number-6{bottom:27px;left:50%;transform:translateX(-50%)}.number-9{top:50%;left:25px;transform:translateY(-50%)}.attendance-hand{position:absolute;z-index:5;left:50%;bottom:50%;transform:translateX(-50%) rotate(0deg);transform-origin:bottom center;border-radius:10px}.attendance-hand--hour{width:4px;height:65px;background:var(--text)}.attendance-hand--minute{width:3px;height:88px;background:var(--primary)}.attendance-hand--second{width:1px;height:98px;background:var(--primary);opacity:.7}.attendance-clock__center{position:absolute;z-index:7;top:50%;left:50%;width:12px;height:12px;transform:translate(-50%,-50%);border:2px solid var(--surface);border-radius:50%;background:var(--primary);box-shadow:0 0 12px color-mix(in srgb,var(--primary) 55%,transparent)}.attendance-digital{position:absolute;z-index:8;bottom:-45px;width:275px;padding:12px 15px;text-align:center;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}.attendance-digital__time{color:var(--text);font-family:"Courier New",monospace;font-size:31px;font-weight:500;letter-spacing:4px;line-height:1.2}.attendance-digital__date{margin-top:6px;color:var(--primary);font-size:8px;font-weight:800;letter-spacing:1.4px}@media(max-width:900px){.attendance-hero{min-height:auto;padding:75px 20px 110px}.attendance-hero__grid{grid-template-columns:1fr;text-align:center;gap:70px}.attendance-hero__content{max-width:750px;margin:auto}.attendance-hero__description{margin-left:auto;margin-right:auto}.attendance-hero__actions,.attendance-stats{justify-content:center}}@media(max-width:600px){.attendance-hero{padding:60px 14px 100px}.attendance-hero h1{font-size:38px;letter-spacing:-1.2px}.attendance-hero__description{font-size:14px}.attendance-hero__actions{display:grid;grid-template-columns:1fr}.attendance-btn{width:100%}.attendance-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:left}.attendance-stat{padding-left:8px}.attendance-stat strong{font-size:13px}.attendance-stat span{font-size:7px;letter-spacing:.5px}.attendance-clock-shell{width:330px;height:330px}.attendance-clock-shell::before{width:270px;height:270px}.attendance-clock-shell::after{width:295px;height:295px}.attendance-clock{width:225px;height:225px}.attendance-hand--hour{height:52px}.attendance-hand--minute{height:72px}.attendance-hand--second{height:80px}.attendance-digital{width:245px;bottom:-48px}.attendance-digital__time{font-size:27px}.number-12{top:22px}.number-6{bottom:22px}.number-3{right:20px}.number-9{left:20px}}
</style>

</MainLayout>
