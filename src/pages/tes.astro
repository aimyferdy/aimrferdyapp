---
import MainLayout from '../layouts/MainLayout.astro';

---
<section class="hero-app">

    <div class="container">

        <div class="breadcrumb">
            <a href="#">Beranda</a>
            <span>›</span>
            <a href="#">Katalog Aplikasi</a>
            <span>›</span>
            <span>Ai Mr Ferdy - Gameplay Menegangkan</span>
        </div>

        <div class="hero-grid">

            <!-- LEFT -->

            <div class="hero-left">

                <div class="hero-tags">

                    <span class="badge blue">
                        FOOTBALL
                    </span>

                    <span class="badge">
                        ✓ Kanal Resmi Ai Mr Ferdy
                    </span>

                </div>

                <h1>
                    Ai Mr Ferdy - Gameplay
                    Menegangkan dalam FPS yang Seru
                </h1>

                <div class="rating">

                    <div class="stars">
                        ★★★★★
                    </div>

                    <strong>4.3</strong>

                    <span>22K+ unduhan</span>

                </div>

                <p class="hero-desc">
                    Dapatkan akses mudah ke berbagai file dan konten berkualitas
                    yang siap diunduh, membuat pengalaman Anda semakin praktis,
                    aman dan menyenangkan.
                </p>

                <div class="hero-info">

                    <div class="info-box">

                        <div class="icon">📦</div>

                        <small>VERSI</small>

                        <strong>v5.4.2</strong>

                    </div>

                    <div class="info-box">

                        <div class="icon">💾</div>

                        <small>UKURAN</small>

                        <strong>43.4 MB</strong>

                    </div>

                    <div class="info-box">

                        <div class="icon">🎮</div>

                        <small>KATEGORI</small>

                        <strong>Football</strong>

                    </div>

                    <div class="info-box">

                        <div class="icon">📅</div>

                        <small>DIPERBARUI</small>

                        <strong>20 Juli 2026</strong>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->

            <aside class="download-card">

                <img
                    src="https://placehold.co/120x120"
                    alt=""
                >

                <h2>AI MR FERDY</h2>

                <p>Unduh melalui Ai Mr Ferdy</p>

                <a href="#" class="download-btn">
                    ↓ Unduh APK v5.4.2
                </a>

                <div class="meta">
                    43.4 MB • Football • 20 Juli 2026
                </div>

                <hr>

                <ul>

                    <li>✔ Hash SHA-256 Terverifikasi</li>

                    <li>✔ Tanpa Registrasi</li>

                    <li>✔ Android 6.0+</li>

                </ul>

            </aside>

        </div>

    </div>

</section>

<style>
.hero-app{

    padding:70px 0;

    background:
    radial-gradient(circle at 60% 40%,rgba(38,188,108,.25),transparent 45%),
    linear-gradient(135deg,#1f5f38,#48a76b);

    color:#fff;

}

.hero-grid{

    display:grid;
    grid-template-columns:1.5fr 420px;
    gap:60px;
    align-items:center;

}

.breadcrumb{

    margin-bottom:45px;
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    opacity:.9;
    font-size:.95rem;

}

.breadcrumb a{

    color:#fff;
    text-decoration:none;

}

.hero-tags{

    display:flex;
    gap:15px;
    margin-bottom:28px;

}

.badge{

    padding:12px 22px;

    border-radius:999px;

    border:1px solid rgba(255,255,255,.2);

    background:rgba(255,255,255,.08);

    backdrop-filter:blur(10px);

    font-weight:600;

}

.badge.blue{

    background:#fff;
    color:#2356f6;

}

.hero-left h1{

    font-size:4rem;
    line-height:1.15;
    margin-bottom:28px;

}

.rating{

    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:28px;

}

.stars{

    color:#FFD54A;
    letter-spacing:2px;

}

.hero-desc{

    max-width:760px;

    font-size:1.2rem;

    line-height:1.8;

    opacity:.9;

    margin-bottom:45px;

}

.hero-info{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:18px;

}

.info-box{

    background:rgba(255,255,255,.12);

    border:1px solid rgba(255,255,255,.15);

    border-radius:20px;

    padding:24px;

    backdrop-filter:blur(12px);

}

.info-box .icon{

    font-size:28px;

    margin-bottom:18px;

}

.info-box small{

    display:block;

    color:rgba(255,255,255,.7);

    margin-bottom:10px;

}

.info-box strong{

    font-size:1.3rem;

}

.download-card{

    background:var(--surface);

    color:var(--text);

    border-radius:30px;

    padding:45px;

    box-shadow:var(--shadow);

    text-align:center;

}

.download-card img{

    width:120px;

    border-radius:30px;

    margin-bottom:20px;

}

.download-card h2{

    margin-bottom:10px;

}

.download-card p{

    color:var(--text-secondary);

    margin-bottom:30px;

}

.download-btn{

    display:block;

    background:#14933e;

    color:#fff;

    text-decoration:none;

    font-weight:700;

    padding:20px;

    border-radius:999px;

    font-size:1.3rem;

    transition:var(--transition);

}

.download-btn:hover{

    transform:translateY(-2px);

}

.meta{

    margin:22px 0;

    color:var(--text-secondary);

}

.download-card hr{

    border:none;

    border-top:1px solid var(--border);

    margin:30px 0;

}

.download-card ul{

    list-style:none;

    padding:0;

    margin:0;

    display:flex;

    flex-direction:column;

    gap:18px;

    text-align:left;

}

.download-card li{

    font-size:1rem;

}

@media(max-width:1100px){

.hero-grid{

grid-template-columns:1fr;

}

.download-card{

max-width:480px;

margin:auto;

}

.hero-info{

grid-template-columns:repeat(2,1fr);

}

.hero-left h1{

font-size:3rem;

}

}

@media(max-width:700px){

.hero-info{

grid-template-columns:1fr;

}

.hero-left h1{

font-size:2.2rem;

}

.hero-desc{

font-size:1rem;

}

.hero-tags{

flex-wrap:wrap;

}

}
</style>
