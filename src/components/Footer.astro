---
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

let posts = await getCollection("blog");

// Latest Posts
const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 4);

// Popular Posts
const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 4);
---


<footer>
    <div class="container">
        <div class="footergrid">
            <div>
                <div class="footer-title">AI Mr Ferdy</div>
                <p class="footer-description">
                    PAI Mr Ferdy merupakan platform Smart Research Assistant berbasis kecerdasan buatan untuk membantu penyusunan skripsi, tesis, proposal penelitian, ringkasan jurnal, analisis data, sitasi akademik, dan berbagai kebutuhan riset.
                </p>
            </div>
            <div>
                <div class="footer-title">Latest Posts</div>
                       {
          latestPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
          ))
        }
            </div>
            <div>
                <div class="footer-title">Popular Posts</div>
                       {
          popularPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
          ))
        }
            </div>
        </div>
        <div class="copy">Copyright &copy; {new Date().getFullYear()} {SITE.name}. Seluruh Hak Cipta Dilindungi.</div>
    </div>
</footer>
<script>
const html=document.documentElement;const themeToggle=document.getElementById("themeToggle");const mediaQuery=window.matchMedia("(prefers-color-scheme: dark)");themeToggle.onclick=()=>{const nextTheme=html.dataset.theme==="dark"?"light":"dark";html.dataset.theme=nextTheme;localStorage.setItem("theme",nextTheme)};mediaQuery.addEventListener("change",event=>{const savedTheme=localStorage.getItem("theme");if(!savedTheme){html.dataset.theme=event.matches?"dark":"light"}});

const menu=document.getElementById("menuToggle");const nav=document.getElementById("nav");menu.onclick=()=>{nav.classList.toggle("active");menu.textContent=nav.classList.contains("active")?"✕":"☰"};document.querySelectorAll(".nav a").forEach(link=>{link.onclick=()=>{nav.classList.remove("active");menu.textContent="☰"}})
</script>
