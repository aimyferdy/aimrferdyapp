---
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

let posts = await getCollection("blog");

// Latest Posts
const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 4);

// Popular Posts
const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 4);
---


<footer>
    <div class="container">
        <div class="footergrid">
            <div>
                <div class="footer-title">AI Mr Ferdy</div>
                <p class="footer-description">
                    Platform berbasis teknologi AI modern yang menghadirkan pengalaman digital lebih praktis, aman, nyaman, dan optimal melalui inovasi terkini.
                </p>
            </div>
            <div>
                <div class="footer-title">Latest Posts</div>
                       {
          latestPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
          ))
        }
            </div>
            <div>
                <div class="footer-title">Popular Posts</div>
                       {
          popularPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
          ))
        }
            </div>
        </div>
        <div class="copy">Copyright &copy; {new Date().getFullYear()} {SITE.name}. Seluruh Hak Cipta Dilindungi.</div>
    </div>
</footer>
