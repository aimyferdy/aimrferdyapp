---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<section class="latest">

  <div class="container">

    <header class="latest__header">

      <span class="latest__label">
        Artikel Terbaru
      </span>

      <h2>
        Insight Terbaru Seputar AI, Penelitian, dan Produktivitas Akademik
      </h2>

      <p>
        Temukan pembahasan terbaru mengenai pemanfaatan kecerdasan buatan, metode penelitian, pengelolaan referensi, hingga berbagai strategi belajar yang disusun untuk membantu mahasiswa, peneliti, dan akademisi memperoleh wawasan yang lebih luas.
      </p>

    </header>

    <div class="latest__grid">

      {posts.map((post) => (
        <article class="latest__card">

          <a href={`/blog/${post.slug}`} class="latest__image">
            <img
              src={post.data.image}
              alt={post.data.title}
              loading="lazy"
            >
          </a>

          <div class="latest__content">

            <h3>
              <a href={`/blog/${post.slug}`}>
                {post.data.title}
              </a>
            </h3>

            <p>
              {post.data.description}
            </p>

            <a href={`/blog/${post.slug}`} class="latest__link">
              Baca Selengkapnya →
            </a>

          </div>

        </article>
      ))}

    </div>

  </div>

</section>

<style>
.latest{
    padding:5rem 1rem;
    background:var(--bg);
}

.container{
    max-width:1200px;
    margin:auto;
}

.latest__header{
    max-width:760px;
    margin:0 auto 3rem;
    text-align:center;
}

.latest__label{
    display:inline-block;
    padding:.45rem 1rem;
    margin-bottom:1rem;
    border-radius:999px;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--primary);
    font-size:.9rem;
    font-weight:600;
}

.latest__header h2{
    color:var(--text);
    margin-bottom:1rem;
    font-size:clamp(2rem,4vw,3rem);
}

.latest__header p{
    color:var(--text-secondary);
    line-height:1.8;
}

.latest__grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1.5rem;
}

.latest__card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    overflow:hidden;
    transition:var(--transition);
}

.latest__card:hover{
    transform:translateY(-4px);
    box-shadow:var(--shadow);
}

.latest__image{
    display:block;
    aspect-ratio:16/9;
}

.latest__image img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.latest__content{
    padding:1.5rem;
}

.latest__content h3{
    margin-bottom:.8rem;
    font-size:1.2rem;
}

.latest__content h3 a{
    color:var(--text);
    text-decoration:none;
}

.latest__content p{
    color:var(--text-secondary);
    line-height:1.7;
    margin-bottom:1.25rem;
}

.latest__link{
    color:var(--primary);
    text-decoration:none;
    font-weight:600;
}

@media(max-width:900px){

.latest{
    padding:4rem 1rem;
}

.latest__grid{
    grid-template-columns:1fr;
}

}
</style>
