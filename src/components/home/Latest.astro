---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<section class="latest">

  <div class="container">

    <header class="latest__header">

      <span class="latest__label">
        Artikel Terbaru
      </span>

      <h2>
        Insight Terbaru Seputar AI, Penelitian, dan Produktivitas Akademik
      </h2>

      <p>
        Temukan pembahasan terbaru mengenai pemanfaatan kecerdasan buatan, metode penelitian, pengelolaan referensi, hingga berbagai strategi belajar yang disusun untuk membantu mahasiswa, peneliti, dan akademisi memperoleh wawasan yang lebih luas.
      </p>

    </header>

    <div class="latest__grid">

      {posts.map((post) => (
        <article class="latest__card">

          <a href={`/blog/${post.slug}`} class="latest__image">
            <img
              src={post.data.image}
              alt={post.data.title}
              loading="lazy"
            >
          </a>

          <div class="latest__content">

            <h3>
              <a href={`/blog/${post.slug}`}>
                {post.data.title}
              </a>
            </h3>

            <p>
              {post.data.description}
            </p>

            <a href={`/blog/${post.slug}`} class="latest__link">
              Baca Selengkapnya →
            </a>

          </div>

        </article>
      ))}

    </div>

  </div>

</section>

